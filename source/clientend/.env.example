# Copy to .env.local and adjust.

# "mock" serves every API call from ./dummy_data (no backend needed).
# "http" calls the NestJS backend at NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_MODE=mock

# NestJS API base URL including the version prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Simulated network latency for the mock transport (ms). 0 = instant; use ~300 to test loading states.
NEXT_PUBLIC_MOCK_LATENCY_MS=0

# Public site URL (used for metadata / Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only shared secret for POST /api/revalidate (on-demand cache invalidation
# called by the backend's cache-invalidation worker). Use a long random string.
REVALIDATE_SECRET=change-me-to-a-long-random-string

# Comma-separated hosts allowed for next/image (CDN, S3/R2 bucket domains).
NEXT_PUBLIC_IMAGE_HOSTS=cdn.lunetbuz.com
